
@page "{id:int}"
@model BankApp.Pages.AccountDetailsModel
@{
    ViewData["Title"] = "Account Details";
}

<h2>Account Details</h2>

<div>
    <p>Account Number: @Model.Account.AccountId</p>
    <p>Balance: @Model.Account.Balance</p>

    <h3>Transactions</h3>
    <div id="transactionList">
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in Model.Transactions)
                {
                    <tr>
                        <td>@transaction.Date.ToString("yyyy-MM-dd")</td>
                        <td>@transaction.TypeFormatted</td>
                        <td>@transaction.Amount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button id="loadMoreButton" class="btn btn-primary" onclick="loadMore()">Load More</button>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        let skip = 20;

        let baseUrl = '@Url.Page("AccountDetails", new { handler = "LoadMore", id = Model.Account.AccountId })';

        function loadMore() {
            let url = baseUrl + "&skip=" + skip;
            $.get(url, function (data) {
                $("#transactionList tbody").append(data);
                skip += 20;
            });
        }

    </script>
}